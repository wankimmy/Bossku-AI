APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:28480

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Docker entrypoint chmods storage/logs; all errors go to storage/logs/laravel.log
LOG_CHANNEL=single
LOG_STACK=single
# When false, nested log handler failures propagate and can abort LLM fallbacks / streams.
LOG_IGNORE_EXCEPTIONS=true
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bossku
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional API token when exposing Bossku to the internet (no login; off by default)
BOSSKU_API_AUTH_ENABLED=false
BOSSKU_API_TOKEN=
# Same value for Nuxt UI when auth is enabled (docker-compose frontend env)
# NUXT_PUBLIC_API_TOKEN=

# ── BosskuAI (Ollama Cloud — subscription required for :cloud models) ────────
# API key: https://ollama.com/settings/keys | Upgrade: https://ollama.com/upgrade
BOSSKU_REPO_PATH=/repo
# Bootstrap flags used by the workspace layer and its settings screens
BOSSKU_AUTO_APPLY_FILE_WRITES=true
BOSSKU_REQUIRE_USER_APPROVAL=true
# When false (default), allowlisted commands_run (php artisan test, git status, etc.) run without the approval modal
BOSSKU_REQUIRE_USER_APPROVAL_FOR_COMMANDS=false
# npm/yarn/pnpm in commands_run (Docker backend can run these in the active project or under /workspace)
BOSSKU_ALLOW_PACKAGE_MANAGER_COMMANDS=true
BOSSKU_ALLOW_WORKSPACE_COMMAND_PATHS=true
# Optional extra prefixes: make test|uv run
# BOSSKU_PROJECT_COMMAND_EXTRA_PREFIXES=
BOSSKU_ORCHESTRATOR_CLARIFICATION_MODE=smart
BOSSKU_WORKSPACE_MOUNT=/workspace
BOSSKU_WORKSPACE_HOST_PREFIX=
BOSSKU_WORKSPACE_WRITABLE=true

# Obsidian vault sync (optional) — leave blank to disable
# Set OBSIDIAN_VAULT_PATH to the vault root as seen inside Docker (e.g. /workspace/My-Vault)
# OBSIDIAN_PROJECT_FOLDER is the subfolder name under Projects/ in your vault
OBSIDIAN_VAULT_PATH=
OBSIDIAN_PROJECT_FOLDER=Bossku-AI
# Quote paths that contain spaces (required for valid dotenv parsing)
# Host folder bind-mounted to /workspace in docker-compose (parent of sibling project repos)
# Ollama connection (secrets + URL only — role models live in Settings → Ollama & Models)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Anthropic (optional — can also be saved in Settings → Models UI)
ANTHROPIC_API_KEY=

# Codex / ChatGPT OAuth (Settings → Models → Connect with ChatGPT)
# Redirect URI must match your registered OAuth app (Docker API port 28480)
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_OAUTH_REDIRECT_URI=http://localhost:28480/api/oauth/codex/callback
CODEX_OAUTH_FRONTEND_RETURN_URL=http://localhost:28470/settings/models
# CODEX_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# CODEX_API_BASE_URL=https://api.openai.com

FRONTEND_URL=http://localhost:28470
CORS_ORIGINS=http://localhost:28470

# Nuxt (docker-compose frontend): leave NUXT_PUBLIC_API_BASE empty for same-origin /api proxy.
# Direct API tools (curl, OAuth callback) still use APP_URL on port 28480.

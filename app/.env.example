APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:28480

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Docker entrypoint chmods storage/logs; all errors go to storage/logs/laravel.log
LOG_CHANNEL=single
LOG_STACK=single
# When false, nested log handler failures propagate and can abort LLM fallbacks / streams.
LOG_IGNORE_EXCEPTIONS=true
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bossku
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional API token when exposing Bossku to the internet (no login; off by default)
BOSSKU_API_AUTH_ENABLED=false
BOSSKU_API_TOKEN=
# Same value for Nuxt UI when auth is enabled (docker-compose frontend env)
# NUXT_PUBLIC_API_TOKEN=

# ── BosskuAI (Ollama Cloud — subscription required for :cloud models) ────────
# API key: https://ollama.com/settings/keys | Upgrade: https://ollama.com/upgrade
BOSSKU_REPO_PATH=/repo
# Quote paths that contain spaces (required for valid dotenv parsing)
BOSSKU_WORKSPACE_MOUNT=/workspace
# Host folder bind-mounted to /workspace in docker-compose (parent of sibling project repos)
BOSSKU_WORKSPACE_HOST_PREFIX=

# Pre-run clarification: smart (skip when clear), always (every run), off
BOSSKU_ORCHESTRATOR_CLARIFICATION_MODE=smart

# Auto-approve and write executor file changes to the active project (chat runs)
BOSSKU_AUTO_APPLY_FILE_WRITES=true
# Docker: entrypoint chmods /workspace for www-data when true (see docker-compose.yml)
BOSSKU_WORKSPACE_WRITABLE=true
# Ollama connection (secrets + URL only — role models live in Settings → Ollama & Models)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Anthropic (optional — can also be saved in Settings → Models UI)
ANTHROPIC_API_KEY=

# Codex / ChatGPT OAuth (Settings → Models → Connect with ChatGPT)
# Redirect URI must match your registered OAuth app (Docker API port 28480)
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_OAUTH_REDIRECT_URI=http://localhost:28480/api/oauth/codex/callback
CODEX_OAUTH_FRONTEND_RETURN_URL=http://localhost:28470/settings/models
# CODEX_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# CODEX_API_BASE_URL=https://api.openai.com

FRONTEND_URL=http://localhost:28470
CORS_ORIGINS=http://localhost:28470

# Production-oriented overrides — copy values into app/.env when deploying.

APP_ENV=production
APP_DEBUG=false

BOSSKU_API_AUTH_ENABLED=true
BOSSKU_API_TOKEN=change-me-to-a-long-random-string
NUXT_PUBLIC_API_TOKEN=change-me-to-a-long-random-string

BOSSKU_ALLOW_DOCKER_COMPOSE=false
BOSSKU_WORKSPACE_WRITABLE=false

DB_PASSWORD=change-me-strong-password

FRONTEND_URL=https://bossku.example.com
CORS_ORIGINS=https://bossku.example.com

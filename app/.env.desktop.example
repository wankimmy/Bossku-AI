# BosskuAI native desktop (.exe) - no Docker, no Redis/Postgres.
# install.ps1 copies this to app/.env and substitutes __BOSSKU_HOME__ / __STACK_ROOT__.
# Path values are double-quoted so a Windows username with a space (e.g. "Safwan Hakim") parses.

APP_NAME=BosskuAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:28480

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_IGNORE_EXCEPTIONS=true
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE="__BOSSKU_HOME__/data/bossku.sqlite"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log

BOSSKU_API_AUTH_ENABLED=false
BOSSKU_API_TOKEN=

BOSSKU_REPO_PATH="__STACK_ROOT__"
BOSSKU_AUTO_APPLY_FILE_WRITES=true
BOSSKU_REQUIRE_USER_APPROVAL=true
BOSSKU_REQUIRE_USER_APPROVAL_FOR_COMMANDS=false
BOSSKU_ALLOW_PACKAGE_MANAGER_COMMANDS=true
BOSSKU_ALLOW_WORKSPACE_COMMAND_PATHS=true
BOSSKU_ORCHESTRATOR_CLARIFICATION_MODE=smart
BOSSKU_WORKSPACE_MOUNT="__USER_DOCUMENTS__"
BOSSKU_WORKSPACE_WRITABLE=true
BOSSKU_ALLOW_DOCKER_COMPOSE_COMMANDS=false

# Orchestrator (worktrees, supervisor, CLI, SCM reactions)
BOSSKU_WORKTREE_ENABLED=true
BOSSKU_WORKTREE_AUTO_PROVISION=false
BOSSKU_WORKTREE_FAIL_CLOSED=true
BOSSKU_WORKTREE_CLEANUP_ON_COMPLETE=true
BOSSKU_WORKTREE_PRESERVE_FILES=.env.example
BOSSKU_SUPERVISOR_MAX_CHILDREN=4
BOSSKU_CLI_PROVIDERS_ENABLED=true
BOSSKU_CLI_SESSION_ASYNC_DEFAULT=false
BOSSKU_CLI_SESSION_ASYNC_DEFAULT_WINDOWS=false
BOSSKU_AGENT_HOOK_TOKEN=
BOSSKU_AGENT_HOOK_ALLOWED_HOSTS=127.0.0.1,localhost,::1
BOSSKU_GITHUB_TOKEN=
BOSSKU_REACTIONS_POLL_INTERVAL=60
BOSSKU_LEARNING_REQUIRE_VERIFICATION=true
BOSSKU_MEMORY_WORKTREE_SCOPING=true

OBSIDIAN_VAULT_PATH=
OBSIDIAN_PROJECT_FOLDER=Bossku-AI

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

ANTHROPIC_API_KEY=

CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CODEX_OAUTH_REDIRECT_URI=http://localhost:28480/api/oauth/codex/callback
CODEX_OAUTH_FRONTEND_RETURN_URL=http://localhost:28470/settings/models

FRONTEND_URL=http://localhost:28470
CORS_ORIGINS=http://localhost:28470

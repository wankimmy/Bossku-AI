{
  "name": "bosskuai-desktop",
  "productName": "BosskuAI",
  "version": "3.0.8",
  "description": "BosskuAI desktop app — native Windows installer (PHP+Node, no Docker) or Docker-backed dev mode via BOSSKU_DESKTOP_RUNTIME=docker.",
  "private": true,
  "main": "src/main.js",
  "author": "BosskuAI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}

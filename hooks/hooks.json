{
  "description": "BosskuAI plugin hooks. Paths use ${CLAUDE_PLUGIN_ROOT} so they work in any repo the plugin is enabled for. All hooks are advisory and never block.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ai-assistant/hooks/session-start-context.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ai-assistant/hooks/pre-commit-quality.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ai-assistant/hooks/suggest-compact.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ai-assistant/hooks/session-end-reminder.sh\" \"${CLAUDE_PROJECT_DIR:-}\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ai-assistant/hooks/security-scan-reminder.sh\" \"${CLAUDE_PROJECT_DIR:-}\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ai-assistant/hooks/pre-compact-reminder.sh\" \"${CLAUDE_PROJECT_DIR:-}\""
          }
        ]
      }
    ]
  }
}

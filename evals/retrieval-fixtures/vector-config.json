    "lexical_weight": 0.25,
    "heading_weight": 0.1,
    "recency_weight": 0.05,
    "source_weight": 0.05,
    "min_combined_score": 0.08,
    "min_semantic_without_lexical": 0.12,
    "max_per_document": 2,

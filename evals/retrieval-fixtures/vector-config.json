{
  "database_path": "evals/retrieval-fixtures/retrieval-benchmark.sqlite3",
  "embedding": {
    "provider": "local-hash",
    "dimensions": 384,
    "seed": "bosskuai-eval-v1"
  },
  "chunking": {
    "target_chars": 500,
    "max_chars": 900,
    "min_chars": 120,
    "overlap_blocks": 1

  "source_weights": {
    "agent-profile.md": 0.12,
    "project-understanding.md": 0.12,
    "plan-log.md": 0.08,
    "learning-log.md": 0.08,
    "bug-patterns.md": 0.08,
    "market-notes.md": 0.08
  },
  "noise_markers": [],
  "include": [
    "evals/retrieval-fixtures/agent-profile.md",
    "evals/retrieval-fixtures/project-understanding.md",
    "evals/retrieval-fixtures/plan-log.md",
    "evals/retrieval-fixtures/learning-log.md",
    "evals/retrieval-fixtures/bug-patterns.md",

# BosskuAI — repo-root environment template
#
# The Docker MVP Laravel app reads variables from app/.env (not this file).
# Copy this file to app/.env and adjust, or merge the sections below into app/.env.
# See README "Environment" for Ollama / Ollama Cloud vs OpenAI / Anthropic.

BOSSKU_REPO_PATH=/repo

# Core API keys (read by config/services.php → OpenAiClient / AnthropicClient)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama / Ollama Cloud
# Point OLLAMA_BASE_URL at local docker ollama or Ollama Cloud. Kimi / DeepSeek-style
# executor IDs route via Ollama when model names match BOSSKU_OLLAMA_MODEL_PATTERNS
# (see app/config/bossku_models.php and App\Services\BosskuAi\LlmGateway).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EXECUTOR_MODEL=qwen2.5-coder:32b
BOSSKU_OLLAMA_MODEL_PATTERNS=llama|mistral|codellama|phi|gemma|qwen|kimi|deepseek

# Runtime overrides used by RuntimeSettings (stored overrides merge via Settings UI)
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-5.5
AUDITOR_PROVIDER=anthropic
AUDITOR_MODEL=claude-opus-4.7
EMBEDDING_MODEL=text-embedding-3-small

# Model routing (truth lives in app/config/bossku_models.php — env overrides defaults here)
BOSSKU_ROUTER_LLM_ENABLED=true
BOSSKU_ROUTER_MODEL=gpt-5.5-instant
BOSSKU_ORCHESTRATOR_MODEL=gpt-5.5
BOSSKU_EXECUTOR_DEFAULT_MODEL=kimi-k2.6
BOSSKU_EXECUTOR_FRONTEND_MODEL=kimi-k2.6
BOSSKU_EXECUTOR_BACKEND_MODEL=kimi-k2.6
BOSSKU_EXECUTOR_DEVOPS_MODEL=gpt-5.5
BOSSKU_EXECUTOR_HIGH_RISK_MODEL=gpt-5.5
BOSSKU_AUDITOR_MODEL=claude-opus-4.7
BOSSKU_SECURITY_AUDITOR_MODEL=claude-opus-4.7
BOSSKU_FINAL_REVIEWER_MODEL=gpt-5.5
BOSSKU_WRITER_MODEL=gpt-5.5
BOSSKU_DIRECT_ANSWER_MODEL=gpt-5.5-instant

# Database / Redis — Laravel uses DB_* and REDIS_* (docker-compose.yml aligns defaults).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bossku
DB_USERNAME=bossku
DB_PASSWORD=bossku

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# App / frontend alignment with nginx/docker-compose
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

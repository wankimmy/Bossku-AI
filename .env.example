# BosskuAI Orchestrator (copy to app/.env and adjust; optional root copy for docker-compose overrides)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EXECUTOR_MODEL=llama3
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-4o-mini
AUDITOR_PROVIDER=openai
AUDITOR_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql://bossku:bossku@postgres:5432/bossku
REDIS_URL=redis://redis:6379
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

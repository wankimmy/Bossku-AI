# BosskuAI — repo-root environment template
#
# The Docker MVP Laravel app reads variables from app/.env (not this file).
# Copy this file to app/.env and adjust, or merge the sections below into app/.env.
# BosskuAI Docker MVP is Ollama Cloud-only — no OpenAI / Anthropic keys in the runtime.

BOSSKU_REPO_PATH=/repo

# Ollama Cloud (all chat + memory embeddings)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_EXECUTOR_MODEL=glm-5.1:cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
BOSSKU_MEMORY_OLLAMA_ENABLED=true
BOSSKU_OLLAMA_MODEL_PATTERNS=llama|mistral|codellama|phi|gemma|qwen|kimi|deepseek|glm|gpt|claude|gemini|o1|o3|o4|chatgpt|cloud|nomic

PLANNER_PROVIDER=ollama
PLANNER_MODEL=kimi-k2.6
AUDITOR_PROVIDER=ollama
AUDITOR_MODEL=deepseek-v4-pro
EMBEDDING_MODEL=nomic-embed-text

BOSSKU_ROUTER_LLM_ENABLED=true
BOSSKU_ROUTER_MODEL=kimi-k2.6
BOSSKU_ORCHESTRATOR_MODEL=kimi-k2.6
BOSSKU_EXECUTOR_DEFAULT_MODEL=glm-5.1
BOSSKU_EXECUTOR_FRONTEND_MODEL=glm-5.1
BOSSKU_EXECUTOR_BACKEND_MODEL=glm-5.1
BOSSKU_EXECUTOR_DEVOPS_MODEL=glm-5.1
BOSSKU_EXECUTOR_HIGH_RISK_MODEL=deepseek-v4-pro
BOSSKU_AUDITOR_MODEL=deepseek-v4-pro
BOSSKU_SECURITY_AUDITOR_MODEL=deepseek-v4-pro
BOSSKU_FINAL_REVIEWER_MODEL=deepseek-v4-pro
BOSSKU_WRITER_MODEL=kimi-k2.6
BOSSKU_DIRECT_ANSWER_MODEL=kimi-k2.6

# Optional aliases (defaults in app/config/bossku_models.php)
# BOSSKU_ALIAS_KIMI_K2_6=kimi-k2.6:cloud
# BOSSKU_ALIAS_GLM_5_1=glm-5.1:cloud
# BOSSKU_ALIAS_DEEPSEEK_V4_PRO=deepseek-v4-pro:cloud

# Laravel logging in Docker: mirror app/.env — LOG_CHANNEL=stderr avoids storage/logs permission issues.

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bossku
DB_USERNAME=bossku
DB_PASSWORD=bossku

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# BosskuAI — repo-root environment template
#
# The Docker MVP Laravel app reads variables from app/.env (not this file).
# Copy this file to app/.env and adjust, or merge the sections below into app/.env.

BOSSKU_REPO_PATH=/repo

# Ollama connection only — configure role models in the UI: Settings → Ollama & Models
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Laravel logging in Docker: set LOG_CHANNEL=stderr in app/.env (avoids storage/logs permission issues).

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bossku
DB_USERNAME=bossku
DB_PASSWORD=bossku

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

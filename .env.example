# BosskuAI — repo-root environment template
#
# Copy to .env at repo root for docker compose port substitution.
# The Laravel app reads variables from app/.env — keep APP_URL / FRONTEND_URL in sync with these ports.

# Host ports (uncommon defaults to avoid clashing with 3000/8000/5432/6379)
BOSSKU_PORT_WEB=28470
BOSSKU_PORT_API=28480
BOSSKU_PORT_POSTGRES=28432
BOSSKU_PORT_REDIS=28379

BOSSKU_REPO_PATH=/repo
# Docker backend: entrypoint chmods /workspace so executor auto-apply can write sibling repos
BOSSKU_WORKSPACE_WRITABLE=false

# Ollama connection only — configure role models in the UI: Settings → Ollama & Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Laravel logging in Docker: LOG_CHANNEL=single in app/.env (storage/logs/laravel.log; entrypoint fixes permissions).

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bossku
DB_USERNAME=bossku
DB_PASSWORD=bossku

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:28480
FRONTEND_URL=http://localhost:28470
CORS_ORIGINS=http://localhost:28470

# Docker UI (docker-compose frontend): NUXT_PUBLIC_API_BASE is empty so the browser uses
# same-origin /api on port BOSSKU_PORT_WEB; Nitro proxies to nginx (NUXT_API_PROXY_TARGET).
# Host dev outside Docker: set NUXT_PUBLIC_API_BASE=http://localhost:28480 or rely on nuxt.config fallback proxy.

# Pixel office (auto fetch → export → sync → build on frontend startup)
ZEP_PIXEL_AGENTS_ROOT=/workspace/zep-pixel-agents
BOSSKU_AUTO_PIXEL_OFFICE=true
BOSSKU_PIXEL_OFFICE_SKIP_ASSETS=0
BOSSKU_PIXEL_OFFICE_GRACEFUL=1
BOSSKU_PIXEL_OFFICE_STRICT=0
BOSSKU_AUTO_FETCH_FURNITURE_BUNDLE=1
BOSSKU_ZEP_FURNITURE_CACHE=1
# Optional: BOSSKU_FURNITURE_VSIX_URL=https://.../extension.vsix
# After zep import-tileset: GRACEFUL=0 for strict furniture requirement